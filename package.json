{
  "name": "distractiontax",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "package": "bun run build && bun scripts/package.ts",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "wordlist": "bun scripts/build-wordlist.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/chrome": "0.0.268",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "5.9.3"
  }
}
